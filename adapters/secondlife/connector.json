{
  "id": "secondlife",
  "name": "Second Life",
  "protocol": "xrt-avatar/1",
  "transport": "https-exchange-to-local-websocket",
  "interaction": "lsl-owner-dialog",
  "capabilities": [
    "session-control",
    "status",
    "captions",
    "display-v1"
  ],
  "presentation": {
    "api": "llSetText",
    "maximum_utf8_bytes": 254,
    "enabled_by_default": false,
    "enable_setting": "SHOW_CAPTIONS",
    "presets": "../../presentation/presets.json",
    "preset_environment": "XRT_CAPTION_PRESET",
    "default_preset": "horizontal",
    "preset_projection": "wrapping-and-line-count",
    "font": "viewer-native",
    "background": "viewer-native",
    "maximum_lifetime_ms": 15000,
    "regions": [
      "full",
      "header",
      "messages",
      "footer"
    ]
  },
  "text_source": {
    "api": "llMessageLinked",
    "enabled_by_default": false,
    "enable_setting": "PUBLISH_TEXT_SOURCE",
    "target": "LINK_SET",
    "message_number": 1481790465,
    "id": "NULL_KEY",
    "format": "json-object",
    "fields": {
      "text": "string: sanitized unwrapped source, preserving source line breaks",
      "display_text": "string: native hover projection, at most 254 UTF-8 bytes",
      "expires_ms": "integer: receiver lease, 0 to 8000 milliseconds; renewed while connected",
      "header": "string|null: persistent header",
      "messages": "array of {id,text,ttl_ms}: messages with remaining lifetime, up to 8",
      "footer": "string|null: persistent footer",
      "revision": "integer: display snapshot revision"
    },
    "clear": {
      "text": "",
      "display_text": "",
      "expires_ms": 0
    },
    "relay_caption_frame_maximum_utf8_bytes": 2048,
    "source_overflow": "grapheme-boundary truncation with ellipsis within the complete relay frame budget",
    "receiver": "attachment/XRT-TextDisplay.lsl",
    "relay_display_frame_maximum_utf8_bytes": 8192,
    "receiver_region_setting": "REGION"
  },
  "entrypoint": "attachment/XRT.lsl",
  "host_bridge": "relay/host_bridge.mjs",
  "relay": "relay/server.py",
  "guide": "../../docs/adapters/secondlife/installation.md",
  "sources": [
    "https://wiki.secondlife.com/wiki/LlHTTPRequest",
    "https://wiki.secondlife.com/wiki/Http_response",
    "https://wiki.secondlife.com/wiki/Attach",
    "https://wiki.secondlife.com/wiki/Changed",
    "https://wiki.secondlife.com/wiki/Touch_start",
    "https://wiki.secondlife.com/wiki/LlSetText",
    "https://wiki.secondlife.com/wiki/LlMessageLinked",
    "https://wiki.secondlife.com/wiki/LlList2Json",
    "https://wiki.secondlife.com/wiki/LlDialog"
  ]
}
