{
  "protocol": "xrt-avatar-caption",
  "version": 1,
  "slots": 128,
  "columnCounts": [8, 16, 32],
  "encoding": "unicode-bmp-big-endian",
  "emptyCodepoint": 0,
  "pointerUnit": "chunk",
  "clearPointer": 255,
  "capabilities": {
    "version": "#XRT/Caption/Version",
    "columns": "#XRT/Caption/Columns",
    "bytesPerChunk": "#XRT/Caption/Bytes"
  },
  "bus": {
    "integerBytes": 4,
    "pointer": "XRT/Caption/Pointer",
    "wordPrefix": "XRT/Caption/Word",
    "wordCount": 2,
    "packing": "two-bmp-codepoints-per-signed-int32-high-first"
  },
  "profiles": [
    {
      "bytesPerChunk": 8,
      "glyphsPerChunk": 4,
      "syncedParameters": 3,
      "syncBits": 96
    }
  ],
  "presets": {
    "horizontal": {
      "columns": 32,
      "rows": 4
    },
    "portrait": {
      "columns": 8,
      "rows": 16
    },
    "board": {
      "columns": 32,
      "rows": 4
    }
  },
  "delivery": {
    "updates": "changed-chunks",
    "cancellation": "remove-stream-messages",
    "clearOnDisconnect": true,
    "repeatWhilePointerHeld": true,
    "defaultChunkIntervalMs": 200,
    "historyRecovery": false,
    "receiverIdleTimeoutMs": 20000
  },
  "receiver": "CVRLuaClientBehaviour",
  "renderer": "xrt-sdf-bmp-v1"
}
