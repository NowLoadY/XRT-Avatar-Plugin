{
  "protocol": "xrt-avatar-caption",
  "version": 1,
  "slots": 128,
  "columnCounts": [8, 16, 32],
  "encoding": "unicode-bmp-big-endian",
  "emptyCodepoint": 0,
  "pointerUnit": "chunk",
  "clearPointer": 255,
  "buffering": { "beginPointer": 253, "commitPointer": 254 },
  "capabilities": {
    "version": "XRT/Caption/Version",
    "columns": "XRT/Caption/Columns",
    "bytesPerChunk": "XRT/Caption/Bytes"
  },
  "bus": {
    "integerBytes": 1,
    "pointer": "XRT/Caption/Pointer",
    "bytePrefix": "XRT/Caption/Byte"
  },
  "profiles": [
    { "bytesPerChunk": 8, "glyphsPerChunk": 4, "syncBits": 72 },
    { "bytesPerChunk": 4, "glyphsPerChunk": 2, "syncBits": 40 },
    { "bytesPerChunk": 2, "glyphsPerChunk": 1, "syncBits": 24 }
  ],
  "presets": {
    "horizontal": { "columns": 32, "rows": 4 },
    "portrait": { "columns": 8, "rows": 16 },
    "board": { "columns": 32, "rows": 4 }
  },
  "delivery": {
    "updates": "changed-chunks",
    "cancellation": "remove-stream-messages",
    "clearOnDisconnect": true,
    "repeatWhilePointerHeld": true,
    "defaultChunkIntervalMs": 200,
    "historyRecovery": false
  }
}
