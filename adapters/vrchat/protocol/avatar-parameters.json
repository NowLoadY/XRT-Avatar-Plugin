{
  "protocol": "xrt-avatar-control",
  "version": 1,
  "connector": "oscquery",
  "serviceName": "VRChat",
  "identityPath": "/avatar/change",
  "invalidatePaths": ["/avatar/change"],
  "mutePath": "/avatar/parameters/MuteSelf",
  "parameters": [
    {
      "key": "enabled",
      "name": "XRT/Enabled",
      "type": "Bool",
      "default": 0,
      "saved": false,
      "networkSynced": false,
      "direction": "request-with-host-reset"
    },
    {
      "key": "status",
      "name": "XRT/Status",
      "type": "Int",
      "default": 0,
      "saved": false,
      "networkSynced": false,
      "direction": "host-feedback"
    },
    {
      "key": "version",
      "name": "XRT/Version",
      "type": "Int",
      "default": 1,
      "saved": false,
      "networkSynced": false,
      "direction": "avatar-capability"
    }
  ],
  "statuses": {
    "unavailable": 0,
    "off": 1,
    "starting": 2,
    "active": 3,
    "stopping": 4,
    "error": 5
  }
}
